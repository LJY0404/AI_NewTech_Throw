# ── 실행 모드 ─────────────────────────────────────────
DEMO_MODE=true               # true면 외부 API 대신 캐시/스텁 사용
LOG_LEVEL=INFO

# ── 스케줄러 (시나리오 1) ────────────────────────────
SCHEDULER_ENABLED=false      # 기본 꺼둠(토큰 절약). 데모 땐 POST /api/curate로 1회 실행
SCHEDULER_DEMO_SECONDS=60    # DEMO_MODE일 때 자동 큐레이션 발사 간격(초)

# ── DB ───────────────────────────────────────────────
# 비워두면 backend/donjebwa.db (SQLite) 자동 생성
# DATABASE_URL=sqlite:///./donjebwa.db

# ── CORS (프론트 주소; JSON 배열 형식) ───────────────
# CORS_ORIGINS=["http://localhost:3000"]

# ── A2A 에이전트 URL ─────────────────────────────────
# 로컬은 그대로, 도커에선 http://agents:8001 식으로 교체
PLACE_AGENT_URL=http://localhost:8001
ROUTE_AGENT_URL=http://localhost:8002
STORYTELLER_AGENT_URL=http://localhost:8003

# ── LLM (Gemini) ─────────────────────────────────────
GEMINI_API_KEY=               # Google AI Studio 무료 키
GEMINI_MODEL=gemini-3.1-flash-lite

# ── 노션 (인테그레이션 토큰 + 기존 DB) ───────────────
NOTION_TOKEN=                 # 비우면 노션 적재는 스텁 처리됨
NOTION_DB_ID=

# ── 외부 API (DEMO_MODE=false 일 때만 필요) ──────────
KAKAO_REST_KEY=
TOUR_API_KEY=
SEOUL_API_KEY=
